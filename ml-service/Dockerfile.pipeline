FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app

RUN mkdir -p /app/artifacts /app/prepared-data

EXPOSE 8011

CMD ["uvicorn", "pipeline_runner.main:app", "--host", "0.0.0.0", "--port", "8011"]